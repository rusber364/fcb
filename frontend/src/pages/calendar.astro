---
import { MONTHS_UK } from "@/utils/calendar.mjs";
import CalendarControls from "../components/calendar/CalendarControls.astro";
import CalendarGrid from "../components/calendar/CalendarGrid.astro";
import CalendarInfoBar from "../components/calendar/CalendarInfoBar.astro";
import CalendarPageHeader from "../components/calendar/CalendarPageHeader.astro";
import Layout from "../layouts/Layout.astro";
import { getEvents } from "../utils/sanity";

const events = await getEvents();
const today = new Date();
const currentYear = today.getFullYear();
const years = Array.from({ length: 10 }, (_, i) => currentYear - 2 + i);
---

<Layout title="Календар подій">
  <div class="container font-['Roboto,_Arial,_sans-serif'] pt-7 pb-20 max-md:pt-4">
    <CalendarPageHeader />
    <CalendarControls months={MONTHS_UK} years={years} currentYear={currentYear} currentMonth={today.getMonth()} />
    <CalendarGrid events={events} />
    <CalendarInfoBar />
  </div>
</Layout>

<script>
  import { initCalendar } from "../utils/calendar.mjs";

  const container = document.getElementById("calendar-grid")!;
  const titleEl = document.getElementById("calendar-title")!;
  const monthSelect = document.getElementById("calendar-month-select")!;
  const yearSelect = document.getElementById("calendar-year-select")!;
  const events = JSON.parse(container.dataset.events!);

  initCalendar(container, titleEl, monthSelect, yearSelect, events);
</script>
