---
import { stegaClean } from "@sanity/client/stega";
import { formatDate } from "../utils";
import { cardBackground } from "../utils/image";
import { getPosts } from "../utils/sanity";

const posts = (await getPosts()).slice(0, 6);
---

{
  posts.length > 0 && (
    <section class="news" id="news">
      <div class="container news__panel">
        <div class="section-head">
          <div class="section-head__title">Новини</div>
          <a class="section-head__link" href="/news">
            Усі новини <img src="/img/arrow-read.png" alt="" width="22" height="18" />
          </a>
        </div>

        <div class="news__slider swiper">
          <div class="news__grid swiper-wrapper">
            {posts.map((post) => (
              <a class="news-card swiper-slide" href={`/post/${stegaClean(post.slug.current)}`}>
                <div class="news-card__image" style={cardBackground(post.mainImage)} aria-hidden="true" />
                <time datetime={post._createdAt.slice(0, 10)}>{formatDate(post._createdAt)}</time>
                <div class="news-card__title">{post.title}</div>
                <p>{post.excerpt}</p>
                <span class="news-card__link">
                  Читати далі <img src="/img/arrow-read.png" alt="" width="22" height="18" />
                </span>
              </a>
            ))}
          </div>
          <button
            class="mobile-slider-arrow mobile-slider-arrow_prev news__arrow_prev"
            type="button"
            aria-label="Попередня новина"
          >
            <img src="/img/arrow-left.png" alt="" width="25" height="45" />
          </button>
          <button
            class="mobile-slider-arrow mobile-slider-arrow_next news__arrow_next"
            type="button"
            aria-label="Наступна новина"
          >
            <img src="/img/arrow-right.png" alt="" width="25" height="45" />
          </button>
        </div>
      </div>
    </section>
  )
}
